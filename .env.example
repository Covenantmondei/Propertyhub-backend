# Database Configuration
DATABASE_URL=postgresql://propertyhub:propertyhub_password@db:5432/propertyhub_db
POSTGRES_USER=propertyhub
POSTGRES_PASSWORD=propertyhub_password
POSTGRES_DB=propertyhub_db

# Security & JWT
SECRET_KEY=your-super-secret-jwt-key-here
FRONTEND_URL=http://localhost:5500

# Email Delivery (SMTP Gmail / Brevo)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
EMAIL_HOST_USER=your-brevo-sender-email@domain.com
BREVO_API_KEY=your-brevo-api-key

# Cloudinary (Image & Media Uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

